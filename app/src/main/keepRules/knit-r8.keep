# Knit R8 keep rules. AGP auto-combines every *.keep in this dir (app/src/main/keepRules) into R8's input
# — there is no proguardFiles wiring in app/build.gradle.kts. Ref: https://d.android.com/r/tools/r8/keep-rules
#
# POSTURE (see the release buildType in app/build.gradle.kts): R8 shrinks + optimizes + OBFUSCATES (name
# mangling), in full mode (AGP 9 default). The wire is kotlinx.serialization compiler-plugin CBOR/JSON: map
# keys are the literal property spellings baked into the generated $$serializer descriptors at compile time
# (no @SerialName / no polymorphism / no reflective lookup), which R8 does NOT rewrite — so renaming is
# byte-safe as long as the $$serializer infra is kept (below). We also pin the frozen wire/identity DTOs
# unrenamed as belt-and-suspenders. The one name-coupled path (the FileKind enum on the JSON file-header) is
# fixed in code (FileKind.wire / FileKind.fromWire), so it needs no keep rule.
#
# KEEP RULES ARE A COST. Every `-keep` here blocks shrinking AND optimization AND obfuscation over whatever
# it matches, which is why Play Console's three rates move together. The blanket keeps on Tink, ARSCLib and
# apksig were dropped in ADR 050 (they were 93% of everything R8 was forbidden to touch). What remains is
# pinned for a reason recorded inline. Before adding a rule, prefer `-keepclassmembers` over `-keep` and add
# `allowobfuscation` / `allowoptimization` / `allowshrinking` so only the one property that matters is
# pinned; check the impact with `./gradlew :app:analyzeReleaseR8Config`. If assembleRelease reports missing
# classes, append the -dontwarn lines AGP writes to app/build/outputs/mapping/release/missing_rules.txt —
# a -dontwarn silences a warning without blocking anything, a -keep does not.

# Keep just enough attributes to symbolicate crashes (mapping.txt maps the rest). SourceFile+LineNumberTable
# are the load-bearing pair for readable stack traces once names are mangled; Signature/InnerClasses/
# EnclosingMethod are insurance for Kotlin/serialization reflection (some also arrive via library rules —
# harmless to restate). -renamesourcefileattribute hides original filenames while keeping line numbers.
-keepattributes SourceFile,LineNumberTable,Signature,InnerClasses,EnclosingMethod
-renamesourcefileattribute SourceFile

# ---- kotlinx-serialization -------------------------------------------------------------------------------
# The library ships consumer R8 rules (auto-applied), and every @Serializable type here is resolved via
# reified serializer<T>() (compile-time, no runtime Class.forName) — the friendly case. These app-scoped
# keeps are insurance for the wire/crypto DTOs. If serialization misbehaves under R8, adopt the official
# back-reference rules from the kotlinx.serialization README.
-keep class app.getknit.knit.**$$serializer { *; }
-keepclassmembers class app.getknit.knit.** {
    *** Companion;
    kotlinx.serialization.KSerializer serializer(...);
}

# ---- Wire protocol contract: never RENAME (CBOR/JSON keys are the frozen property spellings) --------------
# Byte-safe even without these (the $$serializer keeps + baked descriptor strings already cover the wire),
# but the wire is frozen-forever so we pin the DTOs unrenamed too. FileKind is deliberately NOT pinned — it's
# decoupled from its wire token in code (FileKind.wire), so a keep rule would only mask a regression here.
-keep class app.getknit.knit.mesh.protocol.** { *; }
-keep class app.getknit.knit.mesh.crypto.MessageContent { *; }
-keep class app.getknit.knit.mesh.crypto.PublicKeyBundle$Proto { *; }
-keep class app.getknit.knit.mesh.link.FileHeaderWire { *; }
-keep class app.getknit.knit.mesh.link.FileHeaderCore { *; }
-keep class app.getknit.knit.mesh.link.DigestWire { *; }
# At-rest device identity (filesDir/identity.key, CBOR): a key-name drift silently re-mints the nodeId and
# breaks every peer's pinned key. Not wire, same blast radius — pin it too. StoredPrekey rides the same
# blob (ratchet signed-prekey privates; a drift would orphan peers' in-flight session initiations).
-keep class app.getknit.knit.data.crypto.IdentityKeyStore$Stored { *; }
-keep class app.getknit.knit.data.crypto.IdentityKeyStore$StoredPrekey { *; }

# ---- Tink (E2E crypto) -----------------------------------------------------------------------------------
# NOT pinned. Tink ships the one consumer rule it needs (META-INF/proguard/protobuf.pro: `<fields>` of the
# shaded GeneratedMessageLite subclasses, applied automatically) and is otherwise designed to be shrunk.
# TinkInit (mesh/crypto/Crypto.kt) calls HybridConfig.register() / SignatureConfig.register(), which
# reference their key managers by static field — R8 traces them — and KeyTemplates.get(String) is a lookup
# in the registry those calls populate, not a Class.forName. The app's surface is narrow and all direct:
# HybridEncrypt/Decrypt, PublicKeySign/Verify, KeysetHandle, RegistryConfiguration, TinkProtoKeysetFormat,
# InsecureSecretKeyAccess, Hpke{Parameters,PublicKey,PrivateKey}, Ed25519{Parameters,PublicKey}, util.Bytes.
# A blanket `-keep com.google.crypto.tink.** { *; }` used to live here; it alone blocked 30,085 items and
# 1.79 MB of dex (21.6% of the whole app) from all three transforms — see ADR 050.
# STILL THE HIGHEST-RISK SURFACE: a missing key manager fails SILENTLY at getPrimitive(), not at load, so
# any change here must be re-verified functionally (seal/open + sign/verify) on a minified build, not by
# checking that the app launches.
-dontwarn com.google.crypto.tink.**

# ---- SQLCipher (at-rest DB encryption) -------------------------------------------------------------------
# JNI (libsqlcipher.so) — keep the classes with native methods.
-keep class net.zetetic.** { *; }
-dontwarn net.zetetic.**

# ---- LiteRT / TensorFlow Lite (on-device moderation) -----------------------------------------------------
# JNI (libtensorflowlite_jni.so). The moderators fail OPEN, so a stripped Interpreter silently disables
# moderation rather than crashing — verify moderation FUNCTIONALLY on an R8 build, don't just check launch.
-keep class org.tensorflow.lite.** { *; }
-dontwarn org.tensorflow.lite.**

# ---- Offline "Share Knit app": ARSCLib + apksig (ui/invite/ApkMerger) ------------------------------------
# NOT pinned either. Both are reached only from ui/invite/ApkMerger.kt + ui/invite/ShareSigningKey.kt, and
# only through six direct entry points — ApkBundle, ApkModule, AndroidManifest, ResXmlElement, ApkSigner,
# KeyConfig — so R8 traces the whole live surface from ordinary call sites. Blanket keeps here cost 26,371
# items and 1.62 MB of dex; most of that was com.reandroid.dex (657 KB), an APK *dex*-rewriting subtree the
# share path never touches (it repacks resources and re-signs). See ADR 050.
# Verify by actually producing a shared APK and installing it — the merge path is not covered by any test.
-dontwarn com.reandroid.**
-dontwarn com.android.apksig.**

# ---- Bundled platform classes (ARSCLib ships org.xmlpull.v1.*, android.util.AttributeSet, XmlResourceParser) ---
# Nothing to pin. app/build.gradle.kts's StripPlatformCopies transform removes every class android.jar defines from
# the jars a variant packages, so R8 resolves these as library classes: it cannot rename them out from under the
# framework's XmlBlock$Parser (ADR 012), infer the interface uninhabited and compile `parser.next()` to `throw null`
# (ADR 050), or cast to a renamed XmlResourceParser (GitHub #59, 2.11.0-alpha.1). The three pins and the implementor
# keep that stood here are gone with the copies. scripts/r8-platform-gate.sh fails a release whose mapping still
# renames a class the platform defines.

# ---- Google Play In-App Review (optional GMS; pre-gated + failures swallowed at runtime) ------------------
-dontwarn com.google.android.gms.**

# ---- Strip debug/verbose/info logging from the release APK ------------------------------------------------
# R8 elides calls to these (their int return is unused) so Log.d/v/i — including the "TEMP diag" lines that
# print peer nodeIds / discovery / link up-down events in the radio layer — never ship in release logcat.
# Log.w/e are kept for crash triage. Narrow this to d/v only if you want to retain release info-level breadcrumbs.
-assumenosideeffects class android.util.Log {
    public static int d(...);
    public static int v(...);
    public static int i(...);
}
