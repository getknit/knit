<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug only, and only from the shell (DUMP): stores a snapshot as if the phone had answered, so an
             emulator with no phone can show every state. See DemoReceiver. -->
        <receiver
            android:name=".DemoReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.getknit.knit.wear.DEMO" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
