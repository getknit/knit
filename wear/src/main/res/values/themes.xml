<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch theme (Wear OS quality WO-V15): the launcher icon, 48 dp, on black, until StatusActivity
         calls installSplashScreen() and swaps in postSplashScreenTheme. -->
    <style name="Theme.Knit.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@android:style/Theme.DeviceDefault.NoActionBar</item>
    </style>
</resources>
