<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing here is worth a backup: the one file is a cached copy of the phone's status. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
