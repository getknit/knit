<?xml version="1.0" encoding="utf-8"?>
<!-- The splash icon is the launcher icon itself, so the two cannot drift (WO-V15). Round on a watch, so it takes
     the splash screen's whole 48 dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="@dimen/splash_icon_size"
        android:height="@dimen/splash_icon_size"
        android:drawable="@mipmap/ic_launcher"
        android:gravity="center" />
</layer-list>
